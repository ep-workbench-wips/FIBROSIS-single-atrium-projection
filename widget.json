{
    "num_of_systems": 2,
    "static_widgets": [
        {
            "name": "display_plot",
            "widget_type": "QCheckBox",
            "properties": {
                "text": "Display a plotter before outputting case",
                "checked": true
            }
        },
        {
            "name": "threshold",
            "widget_type": "QDoubleSpinBox",
            "properties": {
                "min": 0.0,
                "max": 10000.0,
                "decimals": 2,
                "step": 0.01,
                "value": 0.5
            }
        },
        {
            "name": "above_threshold",
            "widget_type": "QCheckBox",
            "properties": {
                "text": "Tick=above_threshold, Untick=below_threshold",
                "checked": true
            }
        },
        {
            "name": "field_name",
            "widget_type": "QLineEdit",
            "properties": {
                "text": "bipolar_voltage"
            }
        },
        {
            "name": "Note",
            "widget_type": "QLabel",
            "properties": {
                "text": "case_1=model (to_project), case_2=eam_case"
            }
        },
        {
            "name": "Fields",
            "widget_type": "QLabel",
            "properties": {
                "text": "fields: ('bipolar_voltage', \n 'unipolar_voltage', \n 'local_activation_time', \n 'impedance', \n 'force', \n 'thickness', \n 'cell_region', \n 'longitudinal_fibres', \n 'transverse_fibres', \n 'pacing_site', \n 'conduction_velocity', \n 'cv_divergence', \n 'histogram')"
            }
        }
    ]
}